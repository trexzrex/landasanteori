# ══════════════════════════════════════════════════════════════
# LANDASAN TEORI GENERATOR - Environment Variables Template
# ══════════════════════════════════════════════════════════════
# Salin file ini menjadi .env.local lalu isi dengan nilai asli.
#   cp .env.example .env.local        (Linux/macOS)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# JANGAN commit .env.local. Untuk deploy di Vercel, daftarkan
# variabel yang sama di: Project Settings → Environment Variables.
# ══════════════════════════════════════════════════════════════

# ─── AI Provider #1: Google Gemini ────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ─── AI Provider #2: OpenRouter (fallback) ────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Landasan Teori Generator

# ─── AI Provider #3: Apinex (fallback) ────────────────────────
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_API_KEY=your_apinex_api_key_here
APINEX_MODEL=free/deepseek-v4-pro-0813

# ─── Prioritas rantai fallback AI ─────────────────────────────
# Angka lebih kecil dijalankan lebih dulu; 0 = provider dinonaktifkan.
PROVIDER_GEMINI_36_ORDER=1
PROVIDER_GEMINI_35_ORDER=2
PROVIDER_APINEX_ORDER=3

# ─── Parameter generasi ───────────────────────────────────────
# Anggaran waktu total 1 generasi (detik). Harus <= maxDuration API route.
GENERATION_BUDGET_SECONDS=300
# Jumlah putaran perluasan bila draft masih di bawah target panjang.
MAX_EXPANSION_ROUNDS=2

# ─── Sumber jurnal (literature search) ────────────────────────
# OpenAlex gratis; email opsional untuk masuk "polite pool" (lebih stabil).
OPENALEX_API_KEY=
OPENALEX_EMAIL=your_email@example.com
# Semantic Scholar gratis (100 req/5min). API key opsional untuk limit lebih tinggi:
# https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# ─── Upstash Redis (rate limiting login/lookup) ───────────────
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ─── Telegram bot (feedback & alert; server-only) ─────────────
# Jangan pernah pakai prefix NEXT_PUBLIC_ untuk kredensial ini.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Supabase (auth + database) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── SEO & Domain ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://landasanteori.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

