# ══════════════════════════════════════════════════════════════
# LANDASAN TEORI GENERATOR - Environment Variables Template
# ══════════════════════════════════════════════════════════════
# Salin file ini menjadi .env.local lalu isi dengan nilai asli.
#   cp .env.example .env.local        (Linux/macOS)
#   Copy-Item .env.example .env.local (Windows PowerShell)
#
# JANGAN commit .env.local. Untuk deploy di Vercel, daftarkan
# variabel yang sama di: Project Settings → Environment Variables.
# ══════════════════════════════════════════════════════════════

# ─── AI Provider #1: Google Gemini ────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# ─── AI Provider #2: OpenRouter (fallback) ────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_MINIMAX_MODEL=minimax/minimax-m3:free
OPENROUTER_FALLBACK_MODEL=z-ai/glm-5.2:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Landasan Teori Generator

# ─── AI Provider #3: AIHubMix (fallback) ──────────────────────
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_API_KEY=your_aihubmix_api_key_here
AIHUBMIX_MODEL=gemini-3.7-flash-free

# ─── AI Provider #4/#5: OpenAI-compatible endpoints ───────────
TERRA_API_BASE_URL=http://your-terra-endpoint/v1
TERRA_API_KEY=your_terra_api_key_here
TERRA_MODEL=gpt-5.6-terra
FREETOKENFAUCET_API_BASE_URL=https://freetokenfaucet.com/v1
FREETOKENFAUCET_API_KEY=your_freetokenfaucet_api_key_here
FREETOKENFAUCET_MODEL=gpt-5.6-terra

# ─── Prioritas rantai fallback AI ─────────────────────────────
# Angka lebih kecil dijalankan lebih dulu; 0 = provider dinonaktifkan.
PROVIDER_OPENROUTER_MINIMAX_ORDER=1
PROVIDER_OPENROUTER_NVIDIA_ORDER=2
PROVIDER_GEMINI_36_ORDER=3
PROVIDER_GEMINI_35_ORDER=4
PROVIDER_AIHUBMIX_ORDER=5
PROVIDER_TERRA_ORDER=0
PROVIDER_OPENROUTER_GLM_ORDER=0
PROVIDER_FREETOKENFAUCET_ORDER=0

# ─── Parameter generasi ───────────────────────────────────────
# Anggaran waktu total 1 generasi (detik). Harus <= maxDuration API route.
GENERATION_BUDGET_SECONDS=300
# Jumlah putaran perluasan bila draft masih di bawah target panjang.
MAX_EXPANSION_ROUNDS=2

# ─── Sumber jurnal (literature search) ────────────────────────
# OpenAlex gratis; email opsional untuk masuk "polite pool" (lebih stabil).
OPENALEX_API_KEY=
OPENALEX_EMAIL=your_email@example.com
# Semantic Scholar gratis (100 req/5min). API key opsional untuk limit lebih tinggi:
# https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# ─── Upstash Redis (rate limiting login/lookup) ───────────────
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ─── Telegram bot (feedback & alert; server-only) ─────────────
# Jangan pernah pakai prefix NEXT_PUBLIC_ untuk kredensial ini.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Supabase (auth + database) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── SEO & Domain ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://landasanteori.vercel.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

